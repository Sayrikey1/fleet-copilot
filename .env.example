# Copy to .env. Only the API key is needed, and ONLY for live `fleet-copilot ask`
# runs. The offline `demo` command and the whole test suite need no key.

# --- Live LLM (optional) ---
# Either name works (ANTHROPIC_API_KEY or CLAUDE_API_KEY):
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional overrides (defaults shown); all prefixed FLEET_ ---
# FLEET_MODEL=claude-sonnet-5-5
# FLEET_TEMPERATURE=0.0
# FLEET_MAX_TOOL_ROUNDS=6

# Grounding thresholds — the single source of truth shared by the tools and the
# golden evaluation set. Chosen at natural gaps in the data for stable answers.
# FLEET_DISK_LOW_FREE_PCT=10.0
# FLEET_RAM_HIGH_USED_PCT=80.0
# FLEET_BATTERY_EOL_CYCLES=1000
# FLEET_MACOS_FLOOR_MAJOR=15

# Paths (relative to where you run the CLI, i.e. the repo root)
# FLEET_DATASET_PATH=data/device-telemetry-dataset.ndjson
# FLEET_DB_PATH=fleet.db
# FLEET_AUDIT_JSONL_PATH=audit_log.jsonl
